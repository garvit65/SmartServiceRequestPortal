@model CreateRequestDto
@{
    ViewData["Title"] = "Create Service Request";
    var duplicateWarning = (string?)ViewBag.DuplicateWarning;
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-file-earmark-plus me-2"></i>Submit New Service Request</h4>
                <p class="text-muted small mb-0">Fill in the details below. Requests will be automatically routed to the responsible support team.</p>
            </div>
            <div class="card-body p-4">
                <!-- Duplicate Request Warning Alert (AC-01 / Section 6.2) -->
                @if (!string.IsNullOrEmpty(duplicateWarning))
                {
                    <div class="alert alert-warning border-warning shadow-sm" role="alert">
                        <div class="d-flex">
                            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Potential Duplicate Detected!</h5>
                                <p class="mb-2">@duplicateWarning</p>
                                <hr class="my-2" />
                                <small class="text-muted">If you still need to create this separate ticket, check the confirmation box below and submit again.</small>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" id="requestTitle" class="form-control" placeholder="Brief summary of the issue (e.g. Laptop battery replacement)" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                        <div id="duplicateHint" class="small text-danger mt-1 d-none"></div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" id="requestCategory" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            <div class="form-text small">Selecting a category routes the ticket directly to its mapped support team.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level <span class="text-danger">*</span></label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<RequestPriority>()" class="form-select"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PreferredContactMethod" class="form-label fw-semibold">Preferred Contact Method</label>
                        <select asp-for="PreferredContactMethod" asp-items="Html.GetEnumSelectList<ContactMethod>()" class="form-select"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Detailed Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide full details, steps to reproduce, error messages, and asset tags..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Supporting Attachments (Optional)</label>
                        <input type="file" name="attachments" multiple class="form-control" />
                        <div class="form-text small">
                            Allowed extensions: <code>.pdf, .docx, .xlsx, .png, .jpg, .jpeg, .txt, .csv</code>. Max 10MB per file.
                            Stored securely outside public web directory.
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(duplicateWarning))
                    {
                        <div class="mb-4 form-check bg-warning-subtle p-3 rounded border border-warning">
                            <input asp-for="WarningAcknowledged" class="form-check-input ms-0 me-2" checked />
                            <label asp-for="WarningAcknowledged" class="form-check-label fw-semibold text-dark">
                                I acknowledge that a similar ticket exists and confirm I want to submit this new request.
                            </label>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send-fill me-1"></i>Submit Service Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dynamic client-side duplicate warning hint as user types
        const titleInput = document.getElementById('requestTitle');
        const catSelect = document.getElementById('requestCategory');
        const hintDiv = document.getElementById('duplicateHint');

        async function checkDup() {
            const title = titleInput.value.trim();
            const catId = catSelect.value;
            if (title.length > 5 && catId) {
                try {
                    const res = await fetch(`/api/check-duplicate?categoryId=${catId}&title=${encodeURIComponent(title)}`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data.isDuplicate) {
                            hintDiv.textContent = `Notice: Active ticket '${data.existingTitle}' (${data.existingReference}) created on ${data.createdDate} may be a duplicate.`;
                            hintDiv.classList.remove('d-none');
                        } else {
                            hintDiv.classList.add('d-none');
                        }
                    }
                } catch (e) { }
            } else {
                hintDiv.classList.add('d-none');
            }
        }

        titleInput.addEventListener('blur', checkDup);
        catSelect.addEventListener('change', checkDup);
    </script>
}
