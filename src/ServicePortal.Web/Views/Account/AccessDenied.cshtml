@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow-sm border-warning">
            <i class="bi bi-shield-slash-fill text-warning display-1 mb-3"></i>
            <h2 class="fw-bold">Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have sufficient permissions to view or perform operations on the requested resource.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-speedometer2 me-1"></i>Return to Dashboard
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-house me-1"></i>Home
                </a>
            </div>
        </div>
    </div>
</div>
