@model List<Category>
@{
    ViewData["Title"] = "Categories & Teams";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags-fill me-2"></i>Categories & Team Routing</h2>
        <p class="text-muted mb-0">Configure ticket categories and their automatic routing to support teams.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newCatModal">
        <i class="bi bi-plus-circle me-1"></i>Add New Category
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Mapped Support Team</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold">@c.Name</td>
                            <td>@c.Description</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border fs-6">
                                    <i class="bi bi-arrow-right-circle me-1"></i>@c.SupportTeam?.Name
                                </span>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newCatModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddCategory" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Service Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Cloud Database Access" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Brief explanation of ticket scope..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Routing Support Team <span class="text-danger">*</span></label>
                        <select name="supportTeamId" asp-items="ViewBag.Teams" class="form-select" required></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </div>
        </form>
    </div>
</div>
