@model List<SlaPolicy>
@{
    ViewData["Title"] = "SLA Policies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-stopwatch-fill me-2"></i>SLA Target Policies</h2>
        <p class="text-muted mb-0">Define business hours target response and resolution durations per priority.</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-start border-4 @(p.Priority == RequestPriority.Critical ? "border-danger" : p.Priority == RequestPriority.High ? "border-warning" : p.Priority == RequestPriority.Medium ? "border-info" : "border-secondary")">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 d-flex justify-content-between">
                        <span>@p.Priority</span>
                        <span class="badge @(p.Priority == RequestPriority.Critical ? "bg-danger" : p.Priority == RequestPriority.High ? "bg-warning text-dark" : p.Priority == RequestPriority.Medium ? "bg-info text-dark" : "bg-secondary")">
                            Priority
                        </span>
                    </h5>

                    <form asp-action="UpdateSlaPolicy" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Response Target (Business Hours)</label>
                            <div class="input-group">
                                <input type="number" name="responseHours" value="@p.ResponseTargetHours" min="1" max="500" class="form-control" required />
                                <span class="input-group-text">hrs</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Resolution Target (Business Hours)</label>
                            <div class="input-group">
                                <input type="number" name="resolutionHours" value="@p.ResolutionTargetHours" min="1" max="1000" class="form-control" required />
                                <span class="input-group-text">hrs</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                            Update Policy
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="card mt-4 bg-light border-0">
    <div class="card-body">
        <h6 class="fw-bold text-dark mb-1"><i class="bi bi-calendar3 me-1"></i>Business Hours Calculation Rules</h6>
        <p class="small text-muted mb-0">
            Due dates are calculated strictly between <strong>Monday through Friday, 09:00 to 18:00 (9 business hours/day)</strong>.
            Saturdays and Sundays are excluded. Tickets submitted after 18:00 roll over to 09:00 on the following business day.
        </p>
    </div>
</div>
