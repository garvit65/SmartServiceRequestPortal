@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bell-fill me-2"></i>In-App Notification Center</h2>
        <p class="text-muted mb-0">Alerts for request assignments, new comments, status transitions, and SLA events.</p>
    </div>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check2-all me-1"></i>Mark All as Read
            </button>
        </form>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center p-3 @(!n.IsRead ? "bg-light border-start border-4 border-primary" : "")">
                        <div class="d-flex align-items-center">
                            <div class="fs-4 me-3 text-@(n.Type.Contains("Breach") ? "danger" : n.Type.Contains("Assign") ? "primary" : "info")">
                                <i class="bi bi-@(n.Type.Contains("Breach") ? "exclamation-triangle" : n.Type.Contains("Assign") ? "person-plus" : "chat-left-text")"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">@n.Message</div>
                                <small class="text-muted">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC &bull; Type: <code>@n.Type</code></small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (n.RelatedRequestId.HasValue)
                            {
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@n.RelatedRequestId.Value" class="btn btn-sm btn-outline-secondary">
                                    View Ticket
                                </a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkAsRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Mark as read">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary"></i>
                <h6>No notifications right now</h6>
                <p class="small">You are all caught up!</p>
            </div>
        }
    </div>
</div>
