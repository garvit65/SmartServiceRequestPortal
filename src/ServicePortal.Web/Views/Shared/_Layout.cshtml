<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Service Request Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --sidebar-bg: #f8f9fa;
        }
        body {
            background-color: #f4f6f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 0.5rem;
        }
        .badge-role {
            font-size: 0.8rem;
            padding: 0.35em 0.65em;
        }
        .main-content {
            flex: 1;
            padding-top: 1.5rem;
            padding-bottom: 2rem;
        }
        .timeline {
            position: relative;
            padding-left: 2rem;
            border-left: 2px solid #dee2e6;
        }
        .timeline-item {
            margin-bottom: 1.5rem;
            position: relative;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -2.35rem;
            top: 0.25rem;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #0d6efd;
            border: 2px solid #fff;
        }
        .timeline-item.internal::before {
            background-color: #ffc107;
        }
        footer {
            margin-top: auto;
            background: #fff;
            border-top: 1px solid #e9ecef;
            padding: 1rem 0;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-headset me-2"></i>Contoso SSRMP
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-indicator"><i class="bi bi-list text-white"></i></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Requests" asp-action="Index">
                                    <i class="bi bi-ticket-detailed me-1"></i>Service Requests
                                </a>
                            </li>
                            @if (User.IsInRole(AppRoles.Requester) || User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="Requests" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i>New Request
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear-fill me-1"></i>Administration
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Users & Roles</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags me-2"></i>Categories & Teams</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="SlaPolicies"><i class="bi bi-stopwatch me-2"></i>SLA Policies</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i>Audit Logs</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <!-- Demo Quick Switcher Dropdown -->
                        <li class="nav-item dropdown me-3">
                            <button class="btn btn-sm btn-outline-info dropdown-toggle text-info" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-badge me-1"></i>Quick Switch Role
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li class="dropdown-header">Evaluation Demo Personas</li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="QuickLogin" asp-route-role="requester"><i class="bi bi-person me-2"></i>John Requester (Requester)</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="QuickLogin" asp-route-role="agent"><i class="bi bi-headset me-2"></i>Ian IT-Agent (Support Agent)</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="QuickLogin" asp-route-role="lead"><i class="bi bi-diagram-3 me-2"></i>Liam IT-Lead (Team Lead)</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="QuickLogin" asp-route-role="admin"><i class="bi bi-shield-lock me-2"></i>Alice Admin (Administrator)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="QuickLogin" asp-route-role="inactive"><i class="bi bi-slash-circle me-2"></i>Inactive Staff (Test Lockout)</a></li>
                            </ul>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-2"></i>
                                    <span>@User.Identity?.Name</span>
                                    <span class="badge bg-primary ms-2 badge-role">
                                        @(User.IsInRole(AppRoles.Administrator) ? "Admin" :
                                          User.IsInRole(AppRoles.TeamLead) ? "Team Lead" :
                                          User.IsInRole(AppRoles.SupportAgent) ? "Support Agent" : "Requester")
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content container-fluid px-4">
        <!-- Toast Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="text-muted">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 - Contoso Support Services - Smart Service Request Management Portal (SSRMP)
            </div>
            <div>
                <a class="text-decoration-none text-secondary me-3" asp-controller="Home" asp-action="TriggerError">
                    <i class="bi bi-bug me-1"></i>Test Error / Correlation Trace
                </a>
                <span class="text-muted">.NET 10 | EF Core 10 | ASP.NET Core MVC</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Notification Badge Poll
        async function updateNotificationCount() {
            try {
                const res = await fetch('/Notifications/UnreadCount');
                if (res.ok) {
                    const data = await res.json();
                    const badge = document.getElementById('notifBadge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }
            } catch (e) { }
        }
        setInterval(updateNotificationCount, 15000);
        updateNotificationCount();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
